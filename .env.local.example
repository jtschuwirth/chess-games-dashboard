# Firebase web app config — Project settings → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Optional: read-only JSON export at GET /api/export ---------------------
# Leave EXPORT_API_KEY empty and the endpoint stays off and serves nothing.
# Anyone holding this key can read every game and line you have stored.
EXPORT_API_KEY=
# Admin credential, on ONE line. Either a service account key (Project settings ->
# Service accounts -> Generate new private key) or, if org policy blocks those, the
# JSON written by `gcloud auth application-default login`.
FIREBASE_ADMIN_CREDENTIALS=
# Optional: only needed once more than one account has signed in. With a single
# user the export finds it automatically. Your uid is on the Profile page.
EXPORT_UID=
