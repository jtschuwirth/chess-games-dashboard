# Firebase web app config — Project settings → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Who may spend this deployment's own resources --------------------------
# Comma-separated Firebase uids. Server-side engine analysis is restricted to
# these accounts, because it burns real CPU per request and signing in is free.
# Everyone else still gets the engine — it runs in their own browser.
# Your uid is on the Profile page. Empty means nobody, and the route refuses.
ADMIN_IDS=

# --- Optional: JSON export of your own data at GET /api/export --------------
# Authenticated with your Firebase ID token, so it returns your data and nobody
# else's. There is no API key any more. It needs an admin credential because the
# route runs outside any session, and Firestore rules scope documents to their
# owner. On ONE line: either a service account key (Project settings -> Service
# accounts -> Generate new private key) or, if org policy blocks those, the JSON
# written by `gcloud auth application-default login`.
FIREBASE_ADMIN_CREDENTIALS=
